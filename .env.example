# Google Cloud Platform (GCP)
GCP_PROJECT_ID=andina-vision-prod
GCP_REGION=us-central1
RAW_BUCKET=andina-vision-panoramas-raw
TILES_BUCKET=andina-vision-panoramas-tiles
