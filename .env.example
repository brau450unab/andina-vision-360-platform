# Google AI Studio / Gemini API
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
VERTEX_AI_LOCATION=us-central1

# Autenticación y Seguridad
JWT_SECRET=super-secret-jwt-key-for-andina-360-change-in-production
